<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 居眠り検知に必要な権限 -->
    <key>NSHealthShareUsageDescription</key>
    <string>居眠り検知のため心拍数を利用します。</string>
    <key>NSMotionUsageDescription</key>
    <string>居眠り検知のため手首の動き (加速度) を利用します。</string>
    <key>NSHealthRequiredReadAuthorizationTypeIdentifiers</key>
    <array>
        <string>HKQuantityTypeIdentifierHeartRate</string>
    </array>

    <!--
        バックグラウンド実行について
        - WKExtendedRuntimeSession は WKBackgroundModes の宣言は不要。
        - HKWorkoutSession を使っていた頃は workout-processing を入れていたが、
          時計画面からの自動復帰挙動を避けるため廃止。
    -->

    <!-- watchOS アプリ基本設定 -->
    <key>WKWatchKitApp</key>
    <true/>
    <key>WKApplication</key>
    <true/>
    <key>WKRunsIndependentlyOfCompanionApp</key>
    <true/>

    <key>CFBundleDisplayName</key>
    <string>居眠り防止</string>
    <key>CFBundleName</key>
    <string>DrowsinessWatch</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
</dict>
</plist>
