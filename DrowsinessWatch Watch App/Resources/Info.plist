<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 居眠り検知に必要な権限 -->
    <key>NSHealthShareUsageDescription</key>
    <string>居眠り検知のため心拍数を利用します。</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>バックグラウンド継続 (ワークアウト) 選択時にワークアウトセッションを開始します。</string>
    <key>NSMotionUsageDescription</key>
    <string>居眠り検知のため手首の動き (加速度) を利用します。</string>
    <key>NSHealthRequiredReadAuthorizationTypeIdentifiers</key>
    <array>
        <string>HKQuantityTypeIdentifierHeartRate</string>
    </array>

    <!--
        バックグラウンド実行について
        - 拡張実行 (WKExtendedRuntimeSession): 手首上げで自動復帰しない。
          WKBackgroundModes の宣言は不要。
        - ワークアウト (HKWorkoutSession): 長時間稼働可能だが、手首上げで
          自動的にアプリが前面復帰する。このモードの有効化のため
          workout-processing を宣言する。ユーザー設定で選ばれたときだけ
          実際にセッションを開始する。
    -->
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>

    <!-- watchOS アプリ基本設定 -->
    <key>WKWatchKitApp</key>
    <true/>
    <key>WKApplication</key>
    <true/>
    <key>WKRunsIndependentlyOfCompanionApp</key>
    <true/>

    <key>CFBundleDisplayName</key>
    <string>居眠り防止</string>
    <key>CFBundleName</key>
    <string>DrowsinessWatch</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
</dict>
</plist>
